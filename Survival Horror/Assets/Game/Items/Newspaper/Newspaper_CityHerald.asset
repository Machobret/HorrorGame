  Pages:
  - Text:
      IsLocalized: 0
      Unlocalized: '<margin-left=16%><margin-right=2%><b>THE CITY HERALD</b>

        EMERGENCY
        EDITION


        <b>1,998 DEAD</b>

        Hero battle leaves district
        in ruins


        Authorities have confirmed 1,998 deaths following the
        battle in the city centre. Rescue crews are still searching the apartment
        blocks. The official toll is expected to rise.'
      Localized:
        m_TableReference:
          m_TableCollectionName: 
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: 
